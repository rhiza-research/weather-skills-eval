# The harness's own settings. Copy to .env and fill in. compose reads it for
# the eval service; scripts/run-eval.py prefills its questions from it, and
# gives each batch every non-secret setting set here as a batch value. A flag
# given to scripts/run-eval.py overrides a value here.

# Leave a secret below empty to have scripts/run-eval.py read it from Secret
# Manager, after gcloud auth application-default login (on the VM, its service
# account). A secret set here or in the shell is used as it is.
# Google Cloud project whose Secret Manager the secrets are read from. A
# variable NAME is read from the secret weather-skills-eval-<name>, lowercased,
# underscores as dashes (APP_OPENROUTER_API_KEY from
# weather-skills-eval-app-openrouter-api-key).
EVAL_SECRETS_PROJECT=rhiza-shared

# Langfuse project that holds the task dataset and receives experiments and traces.
# The app traces into this same project: the harness gives it these three.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Address of the Langfuse server; required, since the harness gives it to the app.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Langfuse environment of the simulated user's and judge's traces. Must not be production.
LANGFUSE_TRACING_ENVIRONMENT=eval

# Key LiteLLM uses for the simulated user and judge models, and for the request
# that finds which model OpenRouter serves for the run's base model.
OPENROUTER_API_KEY=
# Simulated user model and judge models, as LiteLLM names: openrouter/<org>/<model>.
# EVAL_JUDGE_MODELS is the judge panel: one or more models, comma-separated.
# Runs whose experiments record the same comparability_hash were graded the same
# way (see the README). The simulated user model must accept image input.
# scripts/run-eval.py prefills the simulated user model from here, and offers
# exactly the judges EVAL_JUDGE_MODELS names, each ticked (it exits when none are
# named); it passes the picked values to each run with -e.
EVAL_SIMULATED_USER_MODEL=openrouter/meta-llama/llama-4-maverick
EVAL_JUDGE_MODELS=openrouter/google/gemini-4-argon,openrouter/openai/gpt-6.1-sol,openrouter/mistralai/mistral-large-4-0

# Docker network the app container joins. compose.yaml sets it.
# EVAL_DOCKER_NETWORK=

# Optional timing settings, in seconds, with their defaults.
# EVAL_TRACE_SETTLE_SECONDS must be less than EVAL_TRACE_TIMEOUT_SECONDS.
# EVAL_APP_START_TIMEOUT_SECONDS=600
# EVAL_TURN_TIMEOUT_SECONDS=1800
# EVAL_POLL_INTERVAL_SECONDS=2
# EVAL_TRACE_TIMEOUT_SECONDS=600
# EVAL_TRACE_SETTLE_SECONDS=60
# Retries LiteLLM makes for each simulated-user and judge call, and for the
# served-model request.
# EVAL_MODEL_RETRIES=2
# Such a call still failing with a rate limit (HTTP 429) after those retries is
# made again after a wait, at most EVAL_RATE_LIMIT_RETRIES times (a whole number,
# at least 0). The first wait is EVAL_RATE_LIMIT_BACKOFF_SECONDS (a finite number
# greater than 0) and doubles for each retry, unless the error's Retry-After is longer.
# EVAL_RATE_LIMIT_RETRIES=6
# EVAL_RATE_LIMIT_BACKOFF_SECONDS=15
# max_tokens of each simulated-user and judge call, used unless the call sets its
# own max_tokens or max_completion_tokens; a whole number, at least 1.
# EVAL_MODEL_MAX_TOKENS=16384
# The most user messages a play sends, unless the task sets turn_limit; a whole
# number, at least 1.
# EVAL_MAX_TURNS=20

# Set by the image from the HARNESS_COMMIT build argument; see the README.
# EVAL_HARNESS_COMMIT=

# APP_IMAGE, RUNNER_IMAGE and EVAL_CONCURRENCY are chosen per batch:
# scripts/run-eval.py asks for them and passes them to each run; for a run
# started by hand to debug, pass them with docker compose run -e (see the README).
# How many runs the batch keeps going at once; a whole number, at least 1.
# scripts/run-eval.py prefills its question from it; the harness does not read it.
# EVAL_PARALLEL_RUNS=1
# The tag of ghcr.io/rhiza-research/weather-skills-eval the batch runs in.
# scripts/run-eval.py prefills its question from it.
# EVAL_IMAGE_TAG=main
# The model ids scripts/run-eval.py ticks in its models question, comma-separated.
# EVAL_MODELS=
# The launch scripts/run-eval.py prefills its last question with: vm, docker or none.
# EVAL_LAUNCH=vm
# EVAL_BATCH, recorded in the experiment metadata as batch: scripts/run-eval.py
# gives each batch one; for a run started by hand to debug, pass it with
# docker compose run -e.
# scripts/run-eval.py also sets EVAL_APP_IMAGE_REVISION and
# EVAL_APP_IMAGE_PR_NUMBER from the app image's labels; see the README.

# The configs repo that defines the app's models, skill packs, connections and
# settings. scripts/run-eval.py prefills its question from it, fetches the ref
# you give with this machine's git access, and runs the batch at that commit,
# which the batch downloads without a token, so the repo must be public.
EVAL_CONFIGS_REPO=https://github.com/rhiza-research/weather-skills-configs
# The variable holding each connection's key, by the connection's base URL in
# the configs repo: <base URL>=<VARIABLE>, comma-separated. A run whose commit
# has a connection not listed here does not start.
EVAL_CONNECTION_KEYS=https://openrouter.ai/api/v1=APP_OPENROUTER_API_KEY

# The Langfuse dataset holding the tasks.
EVAL_DATASET=weather-eval-tasks
# true pulls the app image, which downloads it only when the host's copy is not
# the tag's current image; false runs the copy already on the Docker host. A batch
# pulls it once, before the runs, and its runs never pull; scripts/run-eval.py
# prefills that choice from here. A run started by hand to debug (see the
# README) pulls it before it starts.
EVAL_PULL_APP_IMAGE=true
# The app's admin, which the harness signs in as.
EVAL_ADMIN_EMAIL=admin@example.com

# The app's secrets, which the harness gives it as WEBUI_SECRET_KEY,
# BOOTSTRAP_ADMIN_PASSWORD and BOOTSTRAP_ADMIN_API_KEY, and the connection key
# above:
APP_WEBUI_SECRET_KEY=
APP_ADMIN_PASSWORD=
APP_ADMIN_API_KEY=
APP_OPENROUTER_API_KEY=
