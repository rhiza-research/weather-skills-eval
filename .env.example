# The harness's own settings. Copy to .env and fill in; compose reads .env for the eval service.

# Langfuse project that holds the task dataset and receives experiments and traces.
# The app must trace into this same project (configs/example.yaml passes these to it).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Address of the Langfuse server. Unset means https://cloud.langfuse.com;
# configs/example.yaml references it, so set it when using that file.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Langfuse environment of the simulated user's and judge's traces. Must not be production.
LANGFUSE_TRACING_ENVIRONMENT=eval

# Key LiteLLM uses for the simulated user and judge models.
OPENROUTER_API_KEY=
# Simulated user and judge models, as LiteLLM names: openrouter/<org>/<model>.
# Keep them fixed across runs that are compared. The simulated user model must
# accept image input.
EVAL_SIMULATED_USER_MODEL=
EVAL_JUDGE_MODEL=

# Docker network the app container joins. compose.yaml sets it for the eval service.
# EVAL_DOCKER_NETWORK=

# Optional timing settings, in seconds, with their defaults.
# EVAL_TRACE_SETTLE_SECONDS must be less than EVAL_TRACE_TIMEOUT_SECONDS.
# EVAL_APP_START_TIMEOUT_SECONDS=600
# EVAL_TURN_TIMEOUT_SECONDS=1800
# EVAL_POLL_INTERVAL_SECONDS=2
# EVAL_TRACE_TIMEOUT_SECONDS=600
# EVAL_TRACE_SETTLE_SECONDS=60
# How many tasks play at once against the one app container.
# EVAL_CONCURRENCY=1
# Retries LiteLLM makes for each simulated-user and judge call.
# EVAL_MODEL_RETRIES=2
# max_tokens of each simulated-user and judge call, used unless the call sets its
# own max_tokens or max_completion_tokens; a whole number, at least 1.
# EVAL_MODEL_MAX_TOKENS=8192
# The most user messages a play sends, unless the task sets turn_limit; a whole
# number, at least 1.
# EVAL_MAX_TURNS=20

# Set by the image from the HARNESS_COMMIT build argument; see the README.
# EVAL_HARNESS_COMMIT=

# Values configs/example.yaml references as ${NAME}:
APP_WEBUI_SECRET_KEY=
APP_ADMIN_PASSWORD=
APP_ADMIN_API_KEY=
APP_OPENROUTER_API_KEY=
