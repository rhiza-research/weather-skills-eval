# The harness's own settings. Copy to .env and fill in; compose reads .env for the eval service.

# Langfuse project that holds the task dataset and receives experiments and traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Address of the Langfuse server. Unset means https://cloud.langfuse.com.
LANGFUSE_BASE_URL=
# Langfuse environment of the simulated user's and judge's traces. Must not be production.
LANGFUSE_TRACING_ENVIRONMENT=

# Key LiteLLM uses for the simulated user and judge models.
OPENROUTER_API_KEY=
# Simulated user and judge models, as LiteLLM names: openrouter/<org>/<model>.
# Keep them fixed across runs that are compared.
EVAL_SIMULATED_USER_MODEL=
EVAL_JUDGE_MODEL=

# Docker network the app container joins. compose.yaml sets it for the eval service.
# EVAL_DOCKER_NETWORK=

# Optional timing settings, in seconds, with their defaults.
# EVAL_APP_START_TIMEOUT_SECONDS=600
# EVAL_TURN_TIMEOUT_SECONDS=1800
# EVAL_POLL_INTERVAL_SECONDS=2
# EVAL_TRACE_TIMEOUT_SECONDS=600
# EVAL_TRACE_SETTLE_SECONDS=60
# How many tasks play at once against the one app container.
# EVAL_CONCURRENCY=1

# Values the configuration file references as ${NAME}, for example:
# APP_WEBUI_SECRET_KEY=
# APP_ADMIN_PASSWORD=
# APP_ADMIN_API_KEY=
# APP_OPENROUTER_API_KEY=
# APP_LANGFUSE_PUBLIC_KEY=
# APP_LANGFUSE_SECRET_KEY=
